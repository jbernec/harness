# Copy to the root of the project you want to verify.
# A check is a command plus the exit code that counts as passing.

project = "my-project"
spec = "spec.md"

# The agent must not touch these. Changed since HEAD -> the gate refuses.
# New untracked files count too.
protected = ["tests/", "spec.md"]


[[check]]
name = "unit"
cmd = "python -m pytest tests/ -q"
expect = 0
description = "the whole unit suite passes"


# Keep spec.md and checks.toml honest with each other. Without these,
# drift is something you have to remember to notice.

[[check]]
name = "spec_coverage"
cmd = "harness spec coverage"
expect = 0
description = "every requirement has a check, or is marked gate: human"

[[check]]
name = "spec_sync"
cmd = "harness spec sync"
expect = 0
description = "no requirement changed without its check being reviewed"

[[check]]
name = "spec_history"
cmd = "harness spec history"
expect = 0
description = "nothing was superseded or removed without saying why"


# ---------------------------------------------------------------------------
# Patterns worth copying. Uncomment what applies.
# ---------------------------------------------------------------------------

# `files` scopes a check to the paths it is about, so `harness select` can
# shortlist it during the edit-run loop. A check with no `files` always runs.
# Leave it off unless the check is genuinely slow - a check you forgot to
# scope is merely slow, and one you scoped wrongly is silently skipped.
#
# Selection is for iterating. The gate always runs the full set, because the
# easy way to pass a selective suite is to touch nothing it watches.
#
# [[check]]
# name = "api_contract"
# cmd = "python -m pytest tests/test_api.py -q"
# files = ["src/api/", "schema/*.json"]


# A check can assert that something FAILS. That is what `expect` is for.
#
# [[check]]
# name = "rejects_bad_input"
# cmd = "python -m myapp validate bad.json"
# expect = 1


# Link a check to a requirement. `requirement_hash` is written by
# `harness spec bless` - never type it. Change the requirement's wording and
# the hash stops matching, so this check goes red.
#
# [[check]]
# name = "position_limit"
# requirement = "R-002"
# cmd = "python -m pytest tests/test_risk.py -q"


# Preconditions before anything expensive or irreversible. Two seconds here
# beats a forty-minute run that rolls back.
#
# [[check]]
# name = "preconditions"
# cmd = "python -m app.preflight"


# Irreversible actions belong in a runner, not in whatever the agent types
# that day. This asserts nothing bypasses it.
#
# [[check]]
# name = "no_adhoc_writes"
# cmd = "python scripts/assert_writes_go_through_runner.py"


# Determinism is one of the few things worth checking on an AI feature: not
# "is the answer good" (a human decides that) but "is it stable".
#
# [[check]]
# name = "determinism"
# cmd = "python scripts/run_twice_and_diff.py"
